{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/healthcheck",
      "schedule": "0 9 * * *"
    }
  ]
}
